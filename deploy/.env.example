# Nexus Gateway quickstart environment.
#
# Do not fill this in by hand — run ./init-secrets.sh, which generates every
# secret with `openssl rand` and writes .env. This file documents what that
# script produces.
#
# The five service tokens must be identical across services; drift between them
# is the most common cause of 403s between components.

# Database (internal to the compose network; not published to the host)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=nexus_gateway

# Host ports. Set one of these when something else on the box already owns the
# default. Everything the stack advertises as its own address follows them —
# the console origin, the OAuth callback the migrator registers, the issuer —
# so moving a port here does not break the login flow the way editing the
# compose file's `ports:` alone would.
NEXUS_UI_PORT=8080
NEXUS_GATEWAY_PORT=3050
# Only published when the compliance profile is enabled.
NEXUS_PROXY_PORT=3128

# The origin administrators reach the console at. Leave it unset for a local
# install — it then follows NEXUS_UI_PORT — and set it to the real scheme+host
# when the stack sits behind a reverse proxy or a domain name.
# CONTROL_PLANE_PUBLIC_URL=https://gateway.example.com

# Inter-service authentication — generate with: openssl rand -hex 32.
# All five are [MUST MATCH]: every service must hold the identical value, and
# drift between them is the most common cause of 403s between components. (The
# marker lives on its own line, never inline after the `=`, so that copying this
# file to .env cannot fold a comment into a value.)
INTERNAL_SERVICE_TOKEN=
HUB_CONFIG_TOKEN=
ADMIN_KEY_HMAC_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
COMPLIANCE_PROXY_API_TOKEN=

# Administrator password. The seed creates admin@nexus.ai with a password that
# is public in the source repository; the migrator replaces it with this value
# on first run, so this must be set. The email itself is fixed by the seed.
NEXUS_ADMIN_PASSWORD=

# System-assistant Virtual Key, replacing the seed's public deterministic one.
# Format: nvk_ followed by 48 hex characters.
NEXUS_ASSISTANT_SYSTEM_VK=

# Image registry. The published images live on both GHCR and Docker Hub under
# the same names, so either host works. Point this at a local prefix to run
# images you built yourself (see docker/README.md).
NEXUS_REGISTRY=ghcr.io/alphabitcore

# Image tag to run. Use a pinned version (for example 1.3.0) in production.
# Append -avx2 for the AVX2-optimised amd64 build; see the operator doc for
# when that is safe.
NEXUS_VERSION=latest
