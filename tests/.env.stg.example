# tests/.env.stg.example — staging-target test/skill env contract.
#
# Copy to tests/.env.stg (gitignored) and fill in real values. Loaded when
# NEXUS_TEST_TARGET=stg.
#
# Staging is a real deployment with real provider credentials, which is what
# makes it the practical target for the AP-3 SDK-compat suite: the local stack
# has no upstream provider keys, so every completion there answers 502
# PROVIDER_UNAVAILABLE and the suite cannot reach a verdict.
#
# `stg` is a distinct target rather than a reuse of `dev` so a run against
# staging says so in NEXUS_TEST_TARGET, the log dir, and the token cache. Only
# NEXUS_AI_GW_URL and NEXUS_TEST_VK are needed for the sdk_compat suite; the
# admin/SSH entries below are for the prod-style skills that also accept a
# target.

NEXUS_HUB_URL=https://prime5.stg.alphabitcore.io
NEXUS_CP_URL=https://prime5.stg.alphabitcore.io
NEXUS_AI_GW_URL=https://prime5.stg.alphabitcore.io/nexus
NEXUS_PROXY_URL=https://prime5.stg.alphabitcore.io:3128
NEXUS_UI_URL=https://prime5.stg.alphabitcore.io

# Virtual key used by the SDK-compat + protocol suites as the SDK api_key.
NEXUS_TEST_VK=nvk_REPLACE_ME
# Optional: a second key restricted by AllowedModels, to exercise the 403
# MODEL_NOT_ALLOWED path (sdk_compat/test_errors.py case 53 skips without it).
NEXUS_TEST_VK_RESTRICTED=

NEXUS_ADMIN_EMAIL=admin@nexus.ai
NEXUS_ADMIN_PASSWORD=REPLACE_WITH_STG_ADMIN_PASSWORD
NEXUS_OAUTH_CLIENT_ID=cp-ui
NEXUS_OAUTH_REDIRECT_URI=https://prime5.stg.alphabitcore.io/auth/callback
NEXUS_TOKEN_CACHE=/tmp/nexus_test_token_stg

NEXUS_TEST_VERBOSE=0
NEXUS_TEST_LOG_DIR=/tmp/nexus-test-stg
