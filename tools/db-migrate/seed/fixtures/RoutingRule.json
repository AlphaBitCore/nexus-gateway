[
  {
    "id": "08272024-eea1-464e-bbb0-a828c64a1c1e",
    "name": "smart-auto-routing",
    "description": "AI router analyzes user prompt and selects the best model when model is \"auto\"",
    "strategyType": "smart",
    "config": {
      "type": "smart",
      "maxTokens": 1024,
      "timeoutMs": 10000,
      "temperature": 0,
      "systemPrompt": "You are an AI model router for an enterprise gateway. Select the best model for the user's request.\n\n## Available Models\n{modelCatalog}\n\n## Selection Rules\n1. Analyze the task: coding, analysis, creative writing, Q&A, translation, math, reasoning\n2. Match capabilities: images \u2192 vision, tools \u2192 function_calling, long text \u2192 large context\n3. Cost: simple tasks \u2192 cheapest capable model; complex tasks \u2192 most capable\n4. If uncertain, prefer the most capable model\n5. Recency: within each provider, models are listed newest-generation-first; when candidates are equally capable and both fit, prefer the newest - the one listed earlier (higher version number in its code, e.g. -4-8 over -4-7 over -4-6, 5.5 over 5.4)\n\nCRITICAL: keep the \"reason\" field under 30 words. Do not analyse the user's request itself. Classify the task type only.\n\n## Output Format\nReturn ONLY valid JSON: {\"modelId\": \"<exact ID from list>\", \"reason\": \"<brief explanation>\"}",
      "routerModelId": "model:gpt-4o",
      "defaultModelId": "model:gpt-4o-mini",
      "routerProviderId": "6b6d307f-a80b-4dcb-801b-1ffa07e25cab",
      "defaultProviderId": "6b6d307f-a80b-4dcb-801b-1ffa07e25cab"
    },
    "matchConditions": {
      "requestedModelLiterals": [
        "auto"
      ]
    },
    "priority": 25,
    "pipelineStage": 1,
    "fallbackChain": [
      {
        "modelId": "model:gpt-4o-mini",
        "providerId": "6b6d307f-a80b-4dcb-801b-1ffa07e25cab"
      },
      {
        "modelId": "model:moonshot-v1-128k",
        "providerId": "64119a02-f3e4-4ff3-a023-e2289bc3135c"
      }
    ],
    "retryPolicy": null,
    "enabled": true,
    "createdAt": "2026-05-08T14:45:53.082+00:00",
    "updatedAt": "2026-05-14T17:12:19.657+00:00"
  },
  {
    "id": "b04d8d18-59fb-42ed-a09e-5f597d650fbf",
    "name": "cost-aware-routing",
    "description": "Route Marketing project to cheaper model, others to GPT-4o",
    "strategyType": "conditional",
    "config": {
      "type": "conditional",
      "default": {
        "type": "single",
        "modelId": "model:gpt-4o",
        "providerId": "6b6d307f-a80b-4dcb-801b-1ffa07e25cab"
      },
      "conditions": [
        {
          "then": {
            "type": "single",
            "modelId": "model:gpt-4o-mini",
            "providerId": "6b6d307f-a80b-4dcb-801b-1ffa07e25cab"
          },
          "when": {
            "virtualKey.projectId": {
              "$eq": "marketing-project"
            }
          }
        }
      ]
    },
    "matchConditions": {
      "models": [
        "model:gpt-4o",
        "model:gpt-4o-mini"
      ]
    },
    "priority": 20,
    "pipelineStage": 1,
    "fallbackChain": [
      {
        "modelId": "model:moonshot-v1-128k",
        "providerId": "64119a02-f3e4-4ff3-a023-e2289bc3135c"
      }
    ],
    "retryPolicy": null,
    "enabled": false,
    "createdAt": "2026-05-08T14:45:52.815+00:00",
    "updatedAt": "2026-05-10T16:45:26.248+00:00"
  },
