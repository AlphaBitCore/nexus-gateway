# One-shot database initialiser: schema push + PostgreSQL-native extras + seed.
#
# Build context is the repo root (so tools/db-migrate/ can be COPY'd), but
# the install itself is scoped to tools/db-migrate's OWN lockfile — see
# below — not the monorepo's root package-lock.json.
FROM node:22-bookworm-slim
LABEL org.opencontainers.image.title="db-migrator" \
      org.opencontainers.image.source="https://github.com/AlphaBitCore/nexus-gateway" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app/tools/db-migrate
# This image ships THIN: it carries tools/db-migrate's source and lockfile but
# no node_modules. entrypoint.sh installs the dependencies on the first run
# into the `migrator-deps` named volume that deploy/docker-compose.yml mounts
# over this directory's node_modules, and reuses that volume on every later
# `up`. Baking them in instead would carry the whole installed dependency tree
# in every pull of every release; the trade is that the first run must reach the
# npm registry. Measured on arm64: 258MB thin against 660MB with node_modules
# baked in.
#
# tools/db-migrate/package-lock.json is a DEDICATED lockfile scoped to only
# this package's own dependencies (@prisma/adapter-pg, @prisma/client,
# dotenv, pg, prisma, tsx, yaml) and their transitive closure — generated by
# running `npm install --package-lock-only` in isolation, NOT derived from
# (or overlapping with) the monorepo root's single-lockfile npm workspace.
# `npm ci --workspace tools/db-migrate --include-workspace-root` against the
# ROOT lockfile does not isolate the install: that lockfile marks a package
# "dev" only if it is *never* a runtime dependency of *any* workspace, so a
# devDependency of one workspace that is also a regular dependency of another
# would still be installed here even under --omit=dev. Scoping the lockfile
# makes it impossible for a future heavy dependency added to an unrelated
# workspace (control-plane-ui, agent UI, ...) to enter this install at all.
# What the install pulls is dominated by `prisma`'s own transitive closure
# (~300MB+): Prisma Studio (react-dom, elkjs), a dev Postgres for `prisma dev`
# (@electric-sql/pglite), Effect-TS internals, and multi-driver support
# (mysql2).
COPY tools/db-migrate/ ./

# Credential-rotation helpers, shared with the appliance first-boot path. They
# are copied rather than reimplemented because mint-assistant-vk.js must
# byte-match packages/shared/core/keyderive's HKDF derivation; a second copy of
# that logic would be a second thing to keep in sync.
COPY nexus-ami/scripts/set-admin-password.js /opt/nexus-scripts/set-admin-password.js
COPY nexus-ami/scripts/mint-assistant-vk.js /opt/nexus-scripts/mint-assistant-vk.js
COPY nexus-ami/scripts/rotate-demo-secret.js /opt/nexus-scripts/rotate-demo-secret.js

# Demo-tier credential rotation (NexusUser passwords, VirtualKey / AdminApiKey
# plaintexts). Placed under /app/tools/db-migrate, not /opt/nexus-scripts,
# because it needs the `pg` driver that entrypoint.sh's install puts into this
# workspace's node_modules — unlike the three /opt/nexus-scripts
# helpers, which are self-contained (only Node's builtin `crypto`) so they can
# also run standalone on the appliance, which ships no node_modules at all.
COPY docker/db-migrator/rotate-demo-secrets.mjs /app/tools/db-migrate/rotate-demo-secrets.mjs

COPY docker/db-migrator/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
